━━━ 26. PERFORMANCE DE USUARIO ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  performance = ROUND( completedStoryPoints / totalStoryPoints × 100 )

  Si totalStoryPoints = 0 → performance = 0

  También se devuelve:
    totalTickets         = todos los tickets asignados
    completedTickets     = tickets con status = DONE
    inProgressTickets    = tickets con status = IN_PROGRESS
    blockedTickets       = tickets con status = BLOCKED
    totalStoryPoints     = suma de SP de todos sus tickets
    completedStoryPoints = suma de SP de sus tickets DONE
    points               = suma de ticketScore de sus tickets DONE
    sprintsParticipated  = cantidad de sprints distintos con sus tickets


───────────────────────────────────────────────────────────────────
  RESUMEN RÁPIDO — HOJA DE REFERENCIA
───────────────────────────────────────────────────────────────────

  progress          = completedSP / totalSP × 100
  plannedProgress   = elapsedDays / totalDays × 100   (clamped 0-100)
  scheduleVariance  = progress - plannedProgress
  spi               = progress / plannedProgress       (1 si no hay datos)
  hoursVariance     = actualHours - estimatedHours     (solo tickets DONE)
  efficiency        = estimatedHours / actualHours     (solo tickets DONE)

  ticketScore       = priorityPts + (SP × 5) + 5bonus
  estimationBonus   = actualHours <= estimatedHours × 1.15
  accuracy          = ticketsPrecisos / ticketsConEst × 100
  consistency       = weeksActive / 4 × 100
  streak            = días consecutivos hacia atrás con al menos 1 DONE

  Burndown ideal    = totalSP - (totalSP / totalDays × día)
  Burndown real     = totalSP - SPcompletados_hasta_ese_día
  velocity          = SP completados en el sprint

  Risk HIGH         → delayed>=3 OR blocked>=3 OR spi<0.8
  Risk MEDIUM       → delayed>=1 OR blocked>=1 OR spi<1.0
  Risk LOW          → cualquier otro caso

  Badge Intermediate →    0-299 pts
  Badge Advanced     →  300-599 pts
  Badge Pro          →  600-999 pts
  Badge Expert       → 1000-1499 pts
  Badge Master       → 1500-1999 pts
  Badge Legend       → 2000+ pts

